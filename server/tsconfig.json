{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "bun"
    ],
    "lib": [
      "ESNext"
    ]
  },
  "include": [
    "src",
    "test"
  ],
  "exclude": [
    "src/compile-entry.ts",
    "src/assets.gen.ts"
  ]
}
